# Copy this file to a new file named .env and fill in the values. Never share .env or upload it anywhere.

# From dashboard.plaid.com > Developers > Keys
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_secret_here

# Start with sandbox (fake banks). Change to production only when Plaid approves you.
PLAID_ENV=sandbox

# 64 random characters that lock your saved data. Make one with:  npm run make-key
ENCRYPTION_KEY=

PORT=3000

# ---- Local use: leave everything below as it is. ----
# ---- Hosting: see docs/HOSTING.md. ----

# Local only by default. Hosting needs HOST=0.0.0.0 plus APP_URL and TRUST_PROXY.
# HOST=0.0.0.0
# APP_URL=https://your-domain.example
# TRUST_PROXY=1

# Where the encrypted data file is kept. On a host, point this at a persistent disk.
# DATA_DIR=./data

# New accounts: true on your own computer, false by default when hosted.
# ALLOW_SIGNUP=true

# Public demo with sample data only. No Plaid keys, accounts or stored data needed.
# DEMO_ONLY=true
